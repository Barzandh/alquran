<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item>
    <shape android:shape="rectangle">
      <corners android:radius="22dp" />
      <gradient android:type="radial" android:gradientRadius="360dp" android:centerX="0.5" android:centerY="0.35"
          android:startColor="#FF13703A" android:centerColor="#FF0B5229" android:endColor="#FF06361A" />
    </shape>
  </item>
  <item android:top="6dp" android:left="6dp" android:right="6dp" android:bottom="6dp">
    <shape android:shape="rectangle"><corners android:radius="12dp" /><stroke android:width="2dp" android:color="#FFD9B25E" /></shape>
  </item>
</layer-list>
